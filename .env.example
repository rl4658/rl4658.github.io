# Copy to .env.local for local testing. None of these are required; each
# feature stays off until its variable is set. For the GitHub Pages build,
# set the same names as repository Variables (Settings → Secrets and variables
# → Actions → Variables) — deploy.yml passes them into `npm run build`.

# Google Analytics 4 measurement ID (Admin → Data streams → Web → Measurement ID)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager container ID. If set, GTM loads instead of gtag.js —
# add your GA4 tag inside the container so page views are not double-counted.
VITE_GTM_ID=

# Google Search Console "HTML tag" verification token (the content="..." value only).
VITE_GOOGLE_SITE_VERIFICATION=
